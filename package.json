{
  "name": "whenterminal",
  "productName": "WHENTERMINAL",
  "version": "0.24.0",
  "private": true,
  "description": "개인용 상주형 Claude 에이전트 데스크톱 앱 (Claude Agent SDK + Electron)",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "node scripts/sdk-smoke.mjs",
    "test:session": "esbuild scripts/session-test.ts --bundle --platform=node --format=esm --packages=external --alias:electron=./scripts/electron-stub.ts --tsconfig=tsconfig.node.json --outfile=out/test/session-test.mjs && node out/test/session-test.mjs",
    "test:spare": "esbuild scripts/spare-test.ts --bundle --platform=node --format=esm --packages=external --alias:electron=./scripts/electron-stub.ts --tsconfig=tsconfig.node.json --outfile=out/test/spare-test.mjs && node out/test/spare-test.mjs",
    "dist": "npm run build && electron-builder --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "dist:dir": "npm run build && electron-builder --dir",
    "test:e2e": "npm run build && playwright test -c tests/e2e/playwright.config.ts --grep-invert @live",
    "test:e2e:live": "npm run build && playwright test -c tests/e2e/playwright.config.ts --grep @live",
    "icons": "electron scripts/render-icons.cjs",
    "dist:win:zip": "npm run build && electron-builder --win zip --x64 --publish never"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "electron-updater": "^6.8.9",
    "node-pty": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  },
  "build": {
    "appId": "com.when630.whenterminal",
    "productName": "WHENTERMINAL",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "node_modules/node-pty/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "files": [
        "!node_modules/@anthropic-ai/claude-agent-sdk-{win32,linux}-*{,/**}",
        "!node_modules/node-pty/prebuilds/win32-*{,/**}"
      ],
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "!node_modules/@anthropic-ai/claude-agent-sdk-{darwin,linux}-*{,/**}"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "icon": "resources/icons/prompt.png",
    "extraResources": [
      {
        "from": "resources/icons",
        "to": "icons",
        "filter": [
          "*.png"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "when630",
        "repo": "WHENTERMINAL",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  }
}
