{
  "name": "whenterminal",
  "productName": "WHENTERMINAL",
  "version": "0.1.0",
  "private": true,
  "description": "개인용 상주형 Claude 에이전트 데스크톱 앱 (Claude Agent SDK + Electron)",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "smoke": "node scripts/sdk-smoke.mjs",
    "test:session": "esbuild scripts/session-test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.node.json --outfile=out/test/session-test.mjs && node out/test/session-test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.293",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/black-han-sans": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "pretendard": "^1.3.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.0",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.7"
  }
}
